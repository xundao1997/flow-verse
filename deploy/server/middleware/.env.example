# Non-secret server settings only. Copy this file to .env before starting.
FLOWVERSE_BIND_ADDRESS=127.0.0.1
FLOWVERSE_TIMEZONE=Asia/Shanghai

FLOWVERSE_POSTGRES_USER=flowverse
FLOWVERSE_POSTGRES_DB=flowverse
FLOWVERSE_POSTGRES_PORT=5432
FLOWVERSE_POSTGRES_CPU_LIMIT=2.0
FLOWVERSE_POSTGRES_MEMORY_LIMIT=2g
FLOWVERSE_POSTGRES_MEMORY_RESERVATION=1g
FLOWVERSE_POSTGRES_SHM_SIZE=1gb
FLOWVERSE_POSTGRES_MAX_CONNECTIONS=50
FLOWVERSE_POSTGRES_SHARED_BUFFERS=512MB
FLOWVERSE_POSTGRES_MAX_WORKER_PROCESSES=6
FLOWVERSE_TIMESCALEDB_MAX_BACKGROUND_WORKERS=2

FLOWVERSE_REDIS_PORT=6379
FLOWVERSE_REDIS_CPU_LIMIT=1.0
FLOWVERSE_REDIS_MEMORY_LIMIT=1g
FLOWVERSE_REDIS_MEMORY_RESERVATION=512m
FLOWVERSE_REDIS_MAXMEMORY=512mb

FLOWVERSE_MINIO_API_PORT=9000
FLOWVERSE_MINIO_CONSOLE_PORT=9001
FLOWVERSE_MINIO_CPU_LIMIT=1.0
FLOWVERSE_MINIO_MEMORY_LIMIT=1g
FLOWVERSE_MINIO_MEMORY_RESERVATION=512m

# MinIO source-build network only; checksum verification remains enabled.
FLOWVERSE_GO_PROXY=https://mirrors.aliyun.com/goproxy/
FLOWVERSE_GO_SUMDB=sum.golang.org
