# FlowVerse native local-development environment.
# Copy this file to .env and replace the local-only password placeholder.
# scripts/start-local.ps1 loads .env without printing values or overriding
# variables already defined in the current process.

FLOWVERSE_LOG_LEVEL=INFO

FLOWVERSE_API_HOST=127.0.0.1
FLOWVERSE_API_PORT=8000
FLOWVERSE_WORKER_HOST=127.0.0.1
FLOWVERSE_WORKER_PORT=8001
FLOWVERSE_WORKER_BASE_URL=http://127.0.0.1:8001
FLOWVERSE_WEB_HOST=127.0.0.1
FLOWVERSE_WEB_PORT=5173
FLOWVERSE_WORKER_REQUEST_TIMEOUT_SECONDS=2
FLOWVERSE_POSTGRES_PROBE_TIMEOUT_SECONDS=2

FLOWVERSE_DATABASE_URL=postgresql+psycopg://flowverse:replace-with-local-development-password@localhost:5432/flowverse

# Object storage is intentionally deferred. No provider or credentials are selected.
